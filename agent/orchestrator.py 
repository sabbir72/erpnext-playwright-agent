"""
ERPNext AI QA - Orchestrator

Main controller for the current pipeline.

Current flow:
    Planner -> Navigator -> Executor -> Analyzer

Inputs:
    data/normalize/*.json       (used by Planner)
    data/plans/latest_plan.json
    .env                         (used by Navigator/Executor)

Outputs:
    data/plans/latest_plan.json
    data/executions/latest_execution.json
    data/reports/latest_analysis.json
    data/reports/latest_orchestration.json

Important:
    This version orchestrates the existing standalone scripts as separate
    processes. Navigator and Executor therefore run as separate Playwright
    browser sessions. A later refactor can move them into shared classes for
    same-browser handoff.
"""

from __future__ import annotations

import argparse
import json
import subprocess
import sys
from datetime import datetime
from pathlib import Path
from typing import Any

BASE_DIR = Path(__file__).resolve().parents[1]
DATA_DIR = BASE_DIR / "data"
PLAN_DIR = DATA_DIR / "plans"
EXECUTION_DIR = DATA_DIR / "executions"
REPORT_DIR = DATA_DIR / "reports"

PLAN_FILE = PLAN_DIR / "latest_plan.json"
EXECUTION_FILE = EXECUTION_DIR / "latest_execution.json"
ANALYSIS_FILE = REPORT_DIR / "latest_analysis.json"
ORCHESTRATION_FILE = REPORT_DIR / "latest_orchestration.json"

for directory in (PLAN_DIR, EXECUTION_DIR, REPORT_DIR):
    directory.mkdir(parents=True, exist_ok=True)


def now() -> str:
    return datetime.now().isoformat(timespec="seconds")


def clean(value: Any) -> str:
    return str(value or "").strip()


def run_step(
    name: str,
    command: list[str],
) -> dict[str, Any]:
    print("=" * 60)
    print(f"[ORCHESTRATOR] {name}")
    print("=" * 60)
    print("COMMAND:", " ".join(command))

    completed = subprocess.run(
        command,
        cwd=BASE_DIR,
        text=True,
    )

    result = {
        "step": name,
        "command": command,
        "returncode": completed.returncode,
        "status": "PASSED" if completed.returncode == 0 else "FAILED",
    }

    print(
        f"[ORCHESTRATOR] {name}: {result['status']} "
        f"(exit={completed.returncode})"
    )
    return result


def load_json(path: Path) -> dict[str, Any] | None:
    if not path.exists():
        return None
    try:
        data = json.loads(path.read_text(encoding="utf-8"))
        return data if isinstance(data, dict) else None
    except Exception:
        return None


def save_final_report(report: dict[str, Any]) -> None:
    ORCHESTRATION_FILE.write_text(
        json.dumps(report, ensure_ascii=False, indent=2),
        encoding="utf-8",
    )


def main() -> int:
    parser = argparse.ArgumentParser(
        description="ERPNext AI QA Orchestrator"
    )
    parser.add_argument(
        "--task",
        required=True,
        help='Task, e.g. "Create Contract flow test"',
    )
    parser.add_argument(
        "--doctype",
        required=True,
        help="DocType, e.g. Contract",
    )
    parser.add_argument(
        "--headed",
        action="store_true",
        help="Run Navigator/Executor with visible browser.",
    )
    parser.add_argument(
        "--skip-planner",
        action="store_true",
        help="Use existing latest_plan.json.",
    )
    parser.add_argument(
        "--skip-navigator",
        action="store_true",
        help="Skip Navigator stage.",
    )
    parser.add_argument(
        "--skip-executor",
        action="store_true",
        help="Skip Executor stage.",
    )
    parser.add_argument(
        "--skip-analyzer",
        action="store_true",
        help="Skip Analyzer stage.",
    )
    args = parser.parse_args()

    started_at = now()
    steps: list[dict[str, Any]] = []
    pipeline_failed = False

    python = sys.executable

    # --------------------------------------------------------
    # 1. PLANNER
    # --------------------------------------------------------
    if not args.skip_planner:
        planner_command = [
            python,
            str(BASE_DIR / "agent" / "planner.py"),
            "--task",
            args.task,
            "--doctype",
            args.doctype,
        ]
        result = run_step("PLANNER", planner_command)
        steps.append(result)
        if result["status"] == "FAILED":
            pipeline_failed = True
    else:
        print("[ORCHESTRATOR] PLANNER: SKIPPED")

    # Plan must exist before downstream stages.
    plan = load_json(PLAN_FILE)
    if plan is None:
        pipeline_failed = True
        print(f"[ORCHESTRATOR] FAILED: Plan not found/invalid: {PLAN_FILE}")

    # Verify Planner target before browser actions.
    if plan is not None:
        plan_doctype = clean(
            plan.get("doctype") or plan.get("document_name")
        )
        if plan_doctype.lower().replace("new ", "", 1) != args.doctype.lower().replace("new ", "", 1):
            pipeline_failed = True
            print(
                "[ORCHESTRATOR] FAILED: Planner DocType mismatch: "
                f"expected={args.doctype}, got={plan_doctype}"
            )

    # --------------------------------------------------------
    # 2. NAVIGATOR
    # --------------------------------------------------------
    if not pipeline_failed and not args.skip_navigator:
        navigator_command = [
            python,
            str(BASE_DIR / "agent" / "navigator.py"),
            "--plan",
            str(PLAN_FILE),
        ]
        if args.headed:
            navigator_command.append("--headed")
        result = run_step("NAVIGATOR", navigator_command)
        steps.append(result)
        if result["status"] == "FAILED":
            pipeline_failed = True
    elif args.skip_navigator:
        print("[ORCHESTRATOR] NAVIGATOR: SKIPPED")

    # --------------------------------------------------------
    # 3. EXECUTOR
    # --------------------------------------------------------
    if not pipeline_failed and not args.skip_executor:
        executor_command = [
            python,
            str(BASE_DIR / "agent" / "executor.py"),
            "--plan",
            str(PLAN_FILE),
        ]
        if args.headed:
            executor_command.append("--headed")
        result = run_step("EXECUTOR", executor_command)
        steps.append(result)
        if result["status"] == "FAILED":
            pipeline_failed = True
    elif args.skip_executor:
        print("[ORCHESTRATOR] EXECUTOR: SKIPPED")

    # --------------------------------------------------------
    # 4. ANALYZER
    # --------------------------------------------------------
    if not pipeline_failed and not args.skip_analyzer:
        analyzer_command = [
            python,
            str(BASE_DIR / "agent" / "analyzer.py"),
            "--file",
            str(EXECUTION_FILE),
        ]
        result = run_step("ANALYZER", analyzer_command)
        steps.append(result)
        if result["status"] == "FAILED":
            pipeline_failed = True
    elif args.skip_analyzer:
        print("[ORCHESTRATOR] ANALYZER: SKIPPED")

    execution = load_json(EXECUTION_FILE)
    analysis = load_json(ANALYSIS_FILE)

    final_status = "FAILED" if pipeline_failed else "COMPLETED"

    final_report = {
        "orchestration_version": "1.0",
        "status": final_status,
        "started_at": started_at,
        "finished_at": now(),
        "task": args.task,
        "doctype": args.doctype,
        "plan_file": str(PLAN_FILE),
        "execution_file": str(EXECUTION_FILE),
        "analysis_file": str(ANALYSIS_FILE),
        "steps": steps,
        "execution_summary": (
            execution.get("summary") if execution else None
        ),
        "analysis_summary": (
            {
                "status": analysis.get("status"),
                "recommendation": analysis.get("recommendation"),
                "failures": analysis.get("failures", []),
                "blocked_actions": analysis.get("blocked_actions", []),
            }
            if analysis
            else None
        ),
    }

    save_final_report(final_report)

    print()
    print("=" * 60)
    print("ORCHESTRATOR SUMMARY")
    print("=" * 60)
    print(f"Task       : {args.task}")
    print(f"DocType    : {args.doctype}")
    print(f"Status     : {final_status}")
    print(f"Plan       : {PLAN_FILE}")
    print(f"Execution  : {EXECUTION_FILE}")
    print(f"Analysis   : {ANALYSIS_FILE}")
    print(f"Final      : {ORCHESTRATION_FILE}")
    print("=" * 60)

    return 0 if not pipeline_failed else 1


if __name__ == "__main__":
    raise SystemExit(main())
